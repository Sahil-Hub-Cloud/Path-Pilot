rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // True when the doc ID matches the caller's UID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // True when the *incoming* resource declares the caller as its owner
    function isCreatingOwnedResource() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // True when the *existing* resource's userId matches the caller
    function isExistingOwnedResource() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Returns the caller's user document (cached by Firestore rules engine)
    function callerDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // True when the authenticated caller is the college admin for collegeId
    function isCollegeAdmin(collegeId) {
      return isAuthenticated() && callerDoc().collegeId == collegeId && callerDoc().role == 'college';
    }

    // True when the authenticated caller is a student belonging to collegeId
    function isCollegeStudent(collegeId) {
      return isAuthenticated() && callerDoc().collegeId == collegeId;
    }

    // ── Users ──────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read, list: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isAuthenticated() && (
        isOwner(userId) ||
        (
          callerDoc().role == 'college' &&
          (
            (resource != null && resource.data.collegeCode == callerDoc().collegeCode) ||
            (request.resource != null && request.resource.data.collegeCode == callerDoc().collegeCode)
          )
        )
      );
      allow delete: if isOwner(userId);

      // Lab Submissions
      match /submissions/{submissionId} {
        allow read, write: if isOwner(userId);
      }

      // Notifications
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      // College Quiz Results stored under the user
      match /college_quizzes/{quizId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── User Profiles ─────────────────────────────────────────────────────────
    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Students (legacy) ─────────────────────────────────────────────────────
    match /students/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Sessions ──────────────────────────────────────────────────────────────
    match /sessions/{sessionId} {
      allow create: if isCreatingOwnedResource();
      allow read, update, delete: if isExistingOwnedResource();
    }

    // ── Roadmaps ──────────────────────────────────────────────────────────────
    match /roadmaps/{roadmapId} {
      allow create: if isCreatingOwnedResource();
      allow read, update, delete: if isExistingOwnedResource();
    }

    // ── Leaderboard ───────────────────────────────────────────────────────────
    match /leaderboard/{entry} {
      allow read: if isAuthenticated();
      allow write: if false; // Cloud Functions only
    }

    // ── Certificates ──────────────────────────────────────────────────────────
    match /certificates/{certId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwnedResource();
      allow update, delete: if isExistingOwnedResource();
    }

    // ── Academic Brains ───────────────────────────────────────────────────────
    match /academic_brains/{userId} {
      allow read, write: if isOwner(userId);
      match /ingestions/{ingestionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── Hiring Requests ───────────────────────────────────────────────────────
    match /hiring_requests/{requestId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated();
    }

    // ── College Syllabi (legacy) ───────────────────────────────────────────────
    match /college_syllabi/{collegeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      match /{allPaths=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // ── Exam Reminders (scheduling system) ────────────────────────────────────
    match /exam_reminders/{reminderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && callerDoc().role == 'college';
    }

    // ── Colleges — THE CORE ISOLATED STRUCTURE ────────────────────────────────
    //
    //   colleges/{collegeId}                   → college profile doc
    //   colleges/{collegeId}/materials/{id}    → uploaded PDFs + AI content
    //   colleges/{collegeId}/exams/{id}        → exam schedule
    //   colleges/{collegeId}/students/{id}     → reference docs (future use)
    //
    match /colleges/{collegeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == collegeId;
      
      match /materials/{materialId} {
        allow read, write: if request.auth != null;
      }
      match /exams/{examId} {
        allow read, write: if request.auth != null;
      }
    }

    // ── Notes Cache (permanent AI-generated notes — public read, server-write only) ──
    match /notes_cache/{cacheId} {
      allow read: if true;    // fast public reads — content is not sensitive
      allow write: if false;  // only Firebase Admin SDK (server) can write
    }

    // ── Topic Notes (legacy cache — same policy) ────────────────────────────
    match /topic_notes/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
