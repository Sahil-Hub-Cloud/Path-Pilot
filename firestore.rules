rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // AUTH HELPERS
    // ============================================
    function isLoggedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }
    function hasRole(role) {
      return isLoggedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function hasAnyRole(roles) {
      return isLoggedIn()
        && roles.hasAny([get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role]);
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && isOwner(userId);
      allow update: if isLoggedIn() && isOwner(userId);
      allow delete: if isLoggedIn() && hasRole('admin');

      match /submissions/{submissionId} {
        allow read: if isLoggedIn() && (isOwner(userId) || hasAnyRole(['admin', 'faculty', 'hod']));
        allow create: if isLoggedIn() && isOwner(userId);
        allow update: if isLoggedIn() && isOwner(userId);
        allow delete: if isLoggedIn() && hasRole('admin');
      }

      match /notifications/{notificationId} {
        allow read: if isLoggedIn() && isOwner(userId);
        allow create: if isLoggedIn() && isOwner(userId);
        allow update: if isLoggedIn() && isOwner(userId);
        allow delete: if isLoggedIn() && isOwner(userId);
      }

      match /college_quizzes/{quizId} {
        allow read: if isLoggedIn() && isOwner(userId);
        allow create: if isLoggedIn() && isOwner(userId);
        allow update: if isLoggedIn() && isOwner(userId);
        allow delete: if isLoggedIn() && isOwner(userId);
      }
    }

    // ============================================
    // STUDENTS
    // ============================================
    match /students/{studentId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && isOwner(studentId);
    }

    // ============================================
    // LEADERBOARD
    // ============================================
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if isLoggedIn() && hasRole('admin');
    }

    // ============================================
    // CERTIFICATES
    // ============================================
    match /certificates/{certId} {
      allow read: if isLoggedIn() && (isOwner(certId) || hasAnyRole(['admin', 'faculty', 'hod']));
      allow create: if isLoggedIn() && (isOwner(certId) || hasRole('admin'));
      allow update: if isLoggedIn() && (isOwner(certId) || hasRole('admin'));
      allow delete: if isLoggedIn() && hasRole('admin');
    }

    // ============================================
    // ACADEMIC BRAINS
    // ============================================
    match /academic_brains/{brainId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && hasAnyRole(['admin', 'faculty', 'hod']);
    }

    // ============================================
    // HIRING REQUESTS
    // ============================================
    match /hiring_requests/{requestId} {
      allow read: if isLoggedIn() && (hasAnyRole(['admin', 'recruiter']) || isOwner(requestId));
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (hasAnyRole(['admin', 'recruiter']) || isOwner(requestId));
      allow delete: if isLoggedIn() && hasRole('admin');
    }

    // ============================================
    // COLLEGE SYLLABI
    // ============================================
    match /college_syllabi/{syllabusId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && hasAnyRole(['admin', 'faculty', 'hod']);
    }

    // ============================================
    // EXAM REMINDERS
    // ============================================
    match /exam_reminders/{reminderId} {
      allow read: if isLoggedIn();
      allow create: if isLoggedIn() && isOwner(reminderId);
      allow update: if isLoggedIn() && isOwner(reminderId);
      allow delete: if isLoggedIn() && isOwner(reminderId);
    }

    // ============================================
    // COLLEGES (with subcollections)
    // ============================================
    match /colleges/{collegeId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn() && hasAnyRole(['admin', 'faculty', 'hod']);

      match /materials/{materialId} {
        allow read: if isLoggedIn();
        allow write: if isLoggedIn() && hasAnyRole(['admin', 'faculty', 'hod']);
      }

      match /exams/{examId} {
        allow read: if isLoggedIn();
        allow write: if isLoggedIn() && hasAnyRole(['admin', 'faculty', 'hod']);
      }
    }

    // ============================================
    // ROADMAPS
    // ============================================
    match /roadmaps/{roadmapId} {
      allow read: if true;
      allow write: if isLoggedIn() && hasRole('admin');
    }

    // ============================================
    // SECURITY LOGS
    // ============================================
    match /security_logs/{logId} {
      allow read: if isLoggedIn() && hasRole('admin');
      allow create: if isLoggedIn();
      allow write: if false;
    }

    // ============================================
    // ADMIN METADATA
    // ============================================
    match /admin/{docId} {
      allow read, write: if isLoggedIn() && hasRole('admin');
    }

    // ============================================
    // FALLBACK — DENY EVERYTHING ELSE
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
